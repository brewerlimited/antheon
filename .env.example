# Existing private GJL preview. Retain current values; do not regenerate.
GJL_PREVIEW_KEY_HASH=
GJL_PREVIEW_BUNDLE_KEY=

# SEO app — all variables are server-only. Never prefix secrets with NEXT_PUBLIC_.
# Use http://localhost:3095 locally; exact canonical HTTPS origin in production.
SEO_APP_URL=http://localhost:3095
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Explicit, isolated fictional-data route. Disable in production unless deliberately presenting it.
SEO_DEMO_MODE=false

# Google Cloud OAuth web application. Callback must use the same origin as SEO_APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3095/seo/auth/google/callback
# Exactly 32 random bytes, encoded as 64 hex characters. Back up securely.
SEO_TOKEN_ENCRYPTION_KEY=

# Optional. PageSpeed can respond without a key, subject to Google's quotas.
PAGESPEED_API_KEY=
# Optional scheduler bearer secret. No cron is installed/enabled automatically.
SEO_CRON_SECRET=

# Future adapter configuration only — setting these does NOT activate a provider yet.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# AHREFS_API_KEY=
# LOCAL_RANK_PROVIDER_KEY=
